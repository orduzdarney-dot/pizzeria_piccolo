use pizzeria_piccolo;

alter table repartidor drop column disponibilidad;
alter table repartidor add column telefono varchar(20);
alter table repartidor add column estado enum('activo','inactivo') default 'activo';

alter table domicilio add column estado enum('en_ruta','entregado','cancelado') default 'en_ruta';

update domicilio set estado = 'entregado' where hora_entrega is not null;

select r.nombre as repartidor, count(d.id) as cantidad_entregas, coalesce(sum(p.total),0) as total_acumulado
from repartidor r
left join domicilio d on r.id = d.id_repartidor and d.estado = 'entregado'
left join pedido p on d.id_pedido = p.id
group by r.id, r.nombre;

select r.id, r.nombre, r.telefono, r.zona, r.estado
from repartidor r
left join domicilio d on r.id = d.id_repartidor
where r.estado = 'activo' and d.id is null;