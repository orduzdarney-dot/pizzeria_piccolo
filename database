create database pizzeria_piccolo;
use pizzeria_piccolo;

create table cliente (id int auto_increment primary key,nombre varchar(100) not null,telefono varchar(20) not null,direccion varchar(150) not null,email varchar(100)
);

create table pizza (id int auto_increment primary key,nombre varchar(50) not null,tamano varchar(20) not null,precio_base decimal(10,2) not null,tipo enum('vegetariana','especial','clasica') not null);

create table ingrediente (id int auto_increment primary key,nombre varchar(50) not null,stock int not null default 0,stock_min int not null default 10,costo decimal(10,2) not null default 0.00);

create table pizza_ingrediente (id_pizza int not null,id_ingrediente int not null,cantidad int not null default 1,primary key (id_pizza, id_ingrediente),foreign key (id_pizza) references pizza(id),foreign key (id_ingrediente) references ingrediente(id));

create table repartidor (id int auto_increment primary key,nombre varchar(100) not null,zona varchar(50) not null,disponibilidad tinyint(1) not null default 1);

create table pedido (id int auto_increment primary key,id_cliente int not null,fecha datetime not null default current_timestamp,metodo_pago enum('efectivo','tarjeta','app') not null,estado enum('pendiente','en preparacion','entregado','cancelado') not null default 'pendiente',total decimal(10,2) default 0.00, foreign key (id_cliente) references cliente(id));

create table pedido_pizza (id_pedido int not null,id_pizza int not null,cantidad int not null default 1, precio decimal(10,2) not null, primary key (id_pedido, id_pizza),foreign key (id_pedido) references pedido(id),foreign key (id_pizza) references pizza(id));

create table domicilio (id int auto_increment primary key,id_pedido int not null,id_repartidor int not null, hora_salida datetime,hora_entrega datetime,distancia_km decimal(5,2), costo_envio decimal(10,2) not null default 0.00, foreign key (id_pedido) references pedido(id), foreign key (id_repartidor) references repartidor(id));

create table historial_precios ( id int auto_increment primary key, id_pizza int not null,precio_anterior decimal(10,2) not null,precio_nuevo decimal(10,2) not null,fecha datetime not null default current_timestamp,foreign key (id_pizza) references pizza(id));



